{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rajeswaran140/crowvault",
  "title": "CrowVault",
  "description": "379 tools that generate production-ready Dockerfiles, Kubernetes, Terraform, schemas, APIs, tests.",
  "version": "3.1.0",
  "websiteUrl": "https://crowvault.ai",
  "repository": {
    "url": "https://github.com/rajeswaran140/crowvault-setup",
    "source": "github"
  },
  "icons": [
    { "src": "https://crowvault.ai/favicon.svg", "mimeType": "image/svg+xml", "sizes": ["any"] }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.crowvault.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {api_key}",
          "description": "CrowVault API key (starts with cv_). Free key with 50 calls/month at https://crowvault.ai/register",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "CrowVault API key (cv_...)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
